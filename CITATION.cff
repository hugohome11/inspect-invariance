    given-names: Milos
    orcid: "https://orcid.org/0000-0002-3190-7751"
    affiliation: "Center for Psychology, Podgorica, Montenegro"
license: MIT
repository-code: "https://github.com/hugohome11/inspect-invariance"
keywords:
  - measurement invariance
  - differential item functioning
  - benchmark validity
  - multilingual evaluation
  - large language models
